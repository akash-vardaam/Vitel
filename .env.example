AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_SES_FROM_EMAIL=no-reply@yourdomain.com
AWS_SES_TO_EMAIL=discover@vitel.life
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# Optional: enforce hostname validation in production (example: vitel.life)
RECAPTCHA_EXPECTED_HOSTNAME=
# Optional: expected v3 action sent by frontend
RECAPTCHA_EXPECTED_ACTION=submit_demo_form
# Optional: minimum v3 score (0.0 to 1.0)
RECAPTCHA_MIN_SCORE=0.5
# Optional: use recaptcha.net if google.com is blocked on server network
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
# Optional: automatic retry endpoint when connection-failed happens
RECAPTCHA_FALLBACK_VERIFY_URL=https://www.recaptcha.net/recaptcha/api/siteverify
